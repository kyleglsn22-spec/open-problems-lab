/-- The claimed solution `w_S` of `X_S w_S = v`. -/
def sol (S : Finset (Fin 6)) : Fin 3 → ℚ := solTable.getD (mask S) 0

/-- Kernel check: `X_S w_S = v` for every nonempty `S`. -/
theorem sol_spec : ∀ S : Finset (Fin 6), S = ∅ ∨ (∑ i ∈ S, Xq i) *ᵥ sol S = vq := by
  decide +kernel

/-- The rational value of `vᵀ Q₆ v`. -/
def qval : ℚ :=
  ∑ S ∈ (Finset.univ : Finset (Finset (Fin 6))) with S.Nonempty,
    (-1 : ℚ) ^ (S.card + 1) * (vq ⬝ᵥ sol S)

theorem qval_neg : qval < 0 := by
  decide +kernel

/-! ## Back to `ℝ` -/

/-- The six matrices, over `ℝ`. -/
noncomputable def X (i : Fin 6) : Matrix (Fin 3) (Fin 3) ℝ := (Xq i).map (Rat.castHom ℝ)

/-- The test vector, over `ℝ`. -/
noncomputable def v : Fin 3 → ℝ := (Rat.castHom ℝ) ∘ vq

theorem X_eq (i : Fin 6) :
    X i = (wt i : ℝ) • vecMulVec ((Rat.castHom ℝ) ∘ uq i) ((Rat.castHom ℝ) ∘ uq i) +
      (1 / 100 : ℝ) • (1 : Matrix (Fin 3) (Fin 3) ℝ) := by
  ext a b
  by_cases h : a = b
  · subst h; simp [X, Xq, vecMulVec_apply]
  · simp [X, Xq, vecMulVec_apply, Matrix.one_apply_ne h]

theorem X_posDef (i : Fin 6) : (X i).PosDef := by
  rw [X_eq]
  have hw : (0 : ℝ) < wt i := by
    have : (0 : ℚ) < wt i := by fin_cases i <;> decide
    exact_mod_cast this
  have h1 : (vecMulVec ((Rat.castHom ℝ) ∘ uq i) ((Rat.castHom ℝ) ∘ uq i)).PosSemidef := by
    simpa using posSemidef_vecMulVec_self_star ((Rat.castHom ℝ) ∘ uq i)
  exact PosDef.posSemidef_add (h1.smul hw.le) (PosDef.one.smul (by norm_num))

theorem sum_X (S : Finset (Fin 6)) :
    ∑ i ∈ S, X i = (∑ i ∈ S, Xq i).map (Rat.castHom ℝ) := by
  ext a b
  simp [X, Matrix.sum_apply]

/-- `X_S⁻¹ v = w_S` over `ℝ`. -/
theorem inv_mulVec (S : Finset (Fin 6)) (hS : S.Nonempty) :
    (∑ i ∈ S, X i)⁻¹ *ᵥ v = (Rat.castHom ℝ) ∘ sol S := by
  have hpd : (∑ i ∈ S, X i).PosDef := posDef_sum hS fun i _ => X_posDef i
  have hunit : IsUnit (∑ i ∈ S, X i) := hpd.isUnit
  let _ := hunit.invertible
  apply inv_mulVec_eq_vec
  have hspec : (∑ i ∈ S, Xq i) *ᵥ sol S = vq :=
    (sol_spec S).resolve_left (Finset.nonempty_iff_ne_empty.mp hS)
  funext a
  rw [sum_X, ← RingHom.map_mulVec]
  simp [v, hspec]

theorem quadratic_form_eq : v ⬝ᵥ (couponMatrix X *ᵥ v) = (qval : ℝ) := by
  unfold couponMatrix qval
  rw [sum_mulVec, dotProduct_sum]
  push_cast
  refine Finset.sum_congr rfl fun S hS => ?_
  have hS' : S.Nonempty := (Finset.mem_filter.mp hS).2
  rw [smul_mulVec, dotProduct_smul, inv_mulVec S hS', smul_eq_mul]
  congr 1
  simp [v, dotProduct]

/-- The six matrices `Xᵢ` and `v = (4, 1, 3)` give `vᵀ Q₆ v < 0`. -/
theorem counterexample : (∀ i, (X i).PosDef) ∧ ¬ (couponMatrix X).PosDef := by
  refine ⟨X_posDef, fun h => ?_⟩
  have hv : v ≠ 0 := by
    intro h0
    have := congrFun h0 0
    simp [v, vq] at this
  have hpos := h.dotProduct_mulVec_pos hv
  rw [star_trivial, quadratic_form_eq] at hpos
  have : (qval : ℝ) < 0 := by exact_mod_cast qval_neg
  linarith

/-- **QC-1.** Sra's quantum coupon-collector conjecture is false (`n = 6`, `d = 3`). -/
theorem not_sraConjecture : ¬ SraConjecture := fun h =>
  counterexample.2 (h 3 6 X (by norm_num) counterexample.1)

