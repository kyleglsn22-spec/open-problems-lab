import Mathlib

/-!
# QC-1: Sra's quantum coupon-collector conjecture is false

For symmetric positive definite `X₁, …, Xₙ`, Sra (MathOverflow question 263833,
March 2017) considered

  `Qₙ(X₁, …, Xₙ) = ∑_{∅ ≠ S ⊆ [n]} (-1)^(|S|+1) (∑_{i ∈ S} Xᵢ)⁻¹`

and conjectured that `Qₙ ≻ 0` for every `n ≥ 1`.  The arXiv note
"GPT, the Counterexample Machine" (arXiv:2608.29595) gives a counterexample
with `n = 6` and `3 × 3` matrices `Xᵢ = wᵢ uᵢ uᵢᵀ + (1/100) I`.  We check it here:
for `v = (4, 1, 3)` we get `vᵀ Q₆ v < 0` (it is about `-95.1`).

Proof idea: for each nonempty `S` we give a rational vector `w_S` with
`X_S w_S = v`, checked by kernel computation over `ℚ`.  Since `X_S` is positive
definite it is invertible, so `X_S⁻¹ v = w_S`, and
`vᵀ Q₆ v = ∑_S (-1)^(|S|+1) v ⬝ w_S`, a rational number checked to be negative.
-/

namespace OpenProblemsLab.QuantumCoupon

open Matrix

/-- Sra's alternating sum `Qₙ(X₁, …, Xₙ)`. -/
noncomputable def couponMatrix {d n : ℕ} (X : Fin n → Matrix (Fin d) (Fin d) ℝ) :
    Matrix (Fin d) (Fin d) ℝ :=
  ∑ S ∈ (Finset.univ : Finset (Finset (Fin n))) with S.Nonempty,
    ((-1 : ℝ) ^ (S.card + 1)) • (∑ i ∈ S, X i)⁻¹

/-- Sra's conjecture (MathOverflow 263833): for every `n ≥ 1` and all symmetric
positive definite `X₁, …, Xₙ` (of any size `d`), `Qₙ(X₁, …, Xₙ)` is positive
definite. -/
def SraConjecture : Prop :=
  ∀ (d n : ℕ) (X : Fin n → Matrix (Fin d) (Fin d) ℝ),
    1 ≤ n → (∀ i, (X i).PosDef) → (couponMatrix X).PosDef

/-! ## The witness, over `ℚ` -/

/-- The rank-one directions `uᵢ`. -/
def uq : Fin 6 → Fin 3 → ℚ :=
  ![![-1, 2, 1], ![0, -3, 1], ![-3, -2, 0], ![2, -2, -2], ![-1, 0, 2], ![-1, 3, 0]]

/-- The weights `wᵢ`. -/
def wt : Fin 6 → ℚ := ![10, 10, 100, 100, 100, 100]

/-- `Xᵢ = wᵢ uᵢ uᵢᵀ + (1/100) I` over `ℚ`. -/
def Xq (i : Fin 6) : Matrix (Fin 3) (Fin 3) ℚ :=
  wt i • vecMulVec (uq i) (uq i) + (1 / 100 : ℚ) • (1 : Matrix (Fin 3) (Fin 3) ℚ)

/-- The test vector `v = (4, 1, 3)`. -/
def vq : Fin 3 → ℚ := ![4, 1, 3]

/-- Bit mask of a subset of `Fin 6`. -/
def mask (S : Finset (Fin 6)) : ℕ := ∑ i ∈ S, 2 ^ i.val

