/-- Every bundle of `p` has an edge outside `{a, b, c, d}`. -/
def survB (p : List (Fin 18) × List (Fin 18 × List (Fin 27))) (a b c d : Fin 27) : Bool :=
  p.2.all fun q => q.2.any fun i => !(i == a || i == b || i == c || i == d)

/-- Some listed set survives deleting edges `a, b, c, d`. -/
def okQ (a b c d : Fin 27) : Bool := Ls.any fun p => survB p a b c d

/-- All sorted quadruples starting with `a, b`. -/
def checkQab (a b : Fin 27) : Bool :=
  (List.finRange 27).all fun c => !(decide (b ≤ c)) ||
    (List.finRange 27).all fun d => !(decide (c ≤ d)) || okQ a b c d

/-- Each entry: six vertices, a bundle for every vertex outside, and every bundle index is an
edge from that vertex to the set. -/
def validL : Bool :=
  Ls.all fun p => p.1.length == 6 &&
    (List.finRange 18).all (fun x => p.1.contains x || p.2.any fun q => q.1 == x) &&
    p.2.all fun q => q.2.all fun i =>
      ((ePair i).1 == q.1 && p.1.contains (ePair i).2) ||
        ((ePair i).2 == q.1 && p.1.contains (ePair i).1)

theorem validL_eq : validL = true := by decide +kernel

