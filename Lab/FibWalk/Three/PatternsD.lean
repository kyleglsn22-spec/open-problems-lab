/-- No window `[n, n + 15]`, `n ≥ 105`, has `IsDown`-pattern `5_5_5` (members at offsets [0, 5, 10, 15]). -/
theorem pat_D_5_5_5 (n : ℕ) (hn : 105 ≤ n)
    (h : ∀ j ≤ 15, (IsDown (n + j) ↔ j = 0 ∨ j = 5 ∨ j = 10 ∨ j = 15)) : False := by
  have hp := phi_bounds
  have M0 : IsDown n := by simpa using (h 0 (by norm_num)).2 (by norm_num)
  have N1 : ¬ IsDown (n + 1) := fun hh => absurd ((h 1 (by norm_num)).1 hh) (by norm_num)
  have N2 : ¬ IsDown (n + 2) := fun hh => absurd ((h 2 (by norm_num)).1 hh) (by norm_num)
  have N3 : ¬ IsDown (n + 3) := fun hh => absurd ((h 3 (by norm_num)).1 hh) (by norm_num)
  have N4 : ¬ IsDown (n + 4) := fun hh => absurd ((h 4 (by norm_num)).1 hh) (by norm_num)
  have M5 : IsDown (n + 5) := (h 5 (by norm_num)).2 (by norm_num)
  have N6 : ¬ IsDown (n + 6) := fun hh => absurd ((h 6 (by norm_num)).1 hh) (by norm_num)
  have N7 : ¬ IsDown (n + 7) := fun hh => absurd ((h 7 (by norm_num)).1 hh) (by norm_num)
