import Lab.FibWalk.Three.Shifts

/-!
# Window case analyses behind `D₃ = U₃` (up-integers)

Generated by `explorer/fib-walk/gen_three.py`. For `T` = down or up, a *pattern* fixes which of
`n, n+1, …, n+g` lie in `T`. Each `pat_T_*` shows that for `n ≥ 105` no window has that pattern.
The proof writes `x = δ n` and `d_j = δ (n+j) = {x + jφ}`, and uses three kinds of facts:
the threshold facts (`δ < ρ` for down-integers, `δ > η` for up-integers), and the shift lemmas
for the same type (`Main.lean` for down, `Three/Shifts.lean` for up). Then `linarith` closes
every case of the interval split of `x`. Patterns: `gap6` (no member among `n+1..n+5`), and each
triple `(a,b,c)` of consecutive gaps in `[1,5]` with `a+b+c ∈ {9,12,14,15}`.
-/

-- Generated proofs: silence style linters (unused hypotheses, unreachable tactic branches).
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

namespace OpenProblemsLab.FibWalk

open Real
open scoped goldenRatio Classical

/-- Real-arithmetic core of the up window `gap6`. -/
theorem core_U_gap6 (x d1 d2 d3 d4 d5 : ℝ)
    (hx0 : 0 ≤ x) (hx1 : x < 1)
    (e1 : d1 = x + (1 * φ - 1) ∨ d1 = x + (1 * φ - 1) - 1) (b1 : 0 ≤ d1 ∧ d1 < 1)
    (e2 : d2 = x + (2 * φ - 3) ∨ d2 = x + (2 * φ - 3) - 1) (b2 : 0 ≤ d2 ∧ d2 < 1)
    (e3 : d3 = x + (3 * φ - 4) ∨ d3 = x + (3 * φ - 4) - 1) (b3 : 0 ≤ d3 ∧ d3 < 1)
    (e4 : d4 = x + (4 * φ - 6) ∨ d4 = x + (4 * φ - 6) - 1) (b4 : 0 ≤ d4 ∧ d4 < 1)
    (e5 : d5 = x + (5 * φ - 8) ∨ d5 = x + (5 * φ - 8) - 1) (b5 : 0 ≤ d5 ∧ d5 < 1)
    (t0 : η < x)
    (t1 : d1 < ρ)
    (t2 : d2 < ρ)
    (t3 : d3 < ρ)
    (t4 : d4 < ρ)
    (t5 : d5 < ρ)
    (s0_2 : 1 - θ₃ < x)
    (s0_5 : 1 - θ₅ < x) : False := by
  have hp := phi_bounds
  simp only [ρ, η, θ₂, θ₃, θ₄, θ₅, θ₆] at *
  obtain ⟨hp1, hp2⟩ := hp
  obtain ⟨b1l, b1r⟩ := b1
  obtain ⟨b2l, b2r⟩ := b2
  obtain ⟨b3l, b3r⟩ := b3
  obtain ⟨b4l, b4r⟩ := b4
  obtain ⟨b5l, b5r⟩ := b5
  rcases e1 with e1 | e1 <;> subst e1 <;> (try linarith) <;>
    rcases e2 with e2 | e2 <;> subst e2 <;> (try linarith) <;>
    rcases e3 with e3 | e3 <;> subst e3 <;> (try linarith) <;>
    rcases e4 with e4 | e4 <;> subst e4 <;> (try linarith) <;>
    rcases e5 with e5 | e5 <;> subst e5 <;> (try linarith)

/-- No window `[n, n + 5]`, `n ≥ 105`, has `IsUp`-pattern `gap6` (members at offsets [0]). -/
theorem pat_U_gap6 (n : ℕ) (hn : 105 ≤ n)
    (h : ∀ j ≤ 5, (IsUp (n + j) ↔ j = 0)) : False := by
  have hp := phi_bounds
  have M0 : IsUp n := by simpa using (h 0 (by norm_num)).2 (by norm_num)
  have N1 : ¬ IsUp (n + 1) := fun hh => absurd ((h 1 (by norm_num)).1 hh) (by norm_num)
  have N2 : ¬ IsUp (n + 2) := fun hh => absurd ((h 2 (by norm_num)).1 hh) (by norm_num)
  have N3 : ¬ IsUp (n + 3) := fun hh => absurd ((h 3 (by norm_num)).1 hh) (by norm_num)
  have N4 : ¬ IsUp (n + 4) := fun hh => absurd ((h 4 (by norm_num)).1 hh) (by norm_num)
  have N5 : ¬ IsUp (n + 5) := fun hh => absurd ((h 5 (by norm_num)).1 hh) (by norm_num)
  exact core_U_gap6
    (δ n) (δ (n + 1)) (δ (n + 2)) (δ (n + 3)) (δ (n + 4)) (δ (n + 5))
    (Int.fract_nonneg _) (Int.fract_lt_one _)
    (by have := delta_add n 1 1 (by norm_num; linarith) (by norm_num; linarith); push_cast at this; exact this)
    ⟨Int.fract_nonneg _, Int.fract_lt_one _⟩
    (by have := delta_add n 2 3 (by norm_num; linarith) (by norm_num; linarith); push_cast at this; exact this)
    ⟨Int.fract_nonneg _, Int.fract_lt_one _⟩
    (by have := delta_add n 3 4 (by norm_num; linarith) (by norm_num; linarith); push_cast at this; exact this)
    ⟨Int.fract_nonneg _, Int.fract_lt_one _⟩
    (by have := delta_add n 4 6 (by norm_num; linarith) (by norm_num; linarith); push_cast at this; exact this)
    ⟨Int.fract_nonneg _, Int.fract_lt_one _⟩
    (by have := delta_add n 5 8 (by norm_num; linarith) (by norm_num; linarith); push_cast at this; exact this)
    ⟨Int.fract_nonneg _, Int.fract_lt_one _⟩
    M0.lt_delta
    (isDown_of_not_isUp (by omega) N1).delta_lt
    (isDown_of_not_isUp (by omega) N2).delta_lt
    (isDown_of_not_isUp (by omega) N3).delta_lt
    (isDown_of_not_isUp (by omega) N4).delta_lt
    (isDown_of_not_isUp (by omega) N5).delta_lt
    (lt_of_not_ge fun hθ => N2 (by have hh := up_plus2 (N := n) (by omega) M0 hθ; rwa [show n + 2 = n + 2 by omega] at hh))
    (lt_of_not_ge fun hθ => N5 (by have hh := up_plus5 (N := n) (by omega) M0 hθ; rwa [show n + 5 = n + 5 by omega] at hh))

