  have N14 : ¬ IsUp (n + 14) := fun hh => absurd ((h 14 (by norm_num)).1 hh) (by norm_num)
  have M15 : IsUp (n + 15) := (h 15 (by norm_num)).2 (by norm_num)
  exact core_U_5_5_5
    (δ n) (δ (n + 1)) (δ (n + 2)) (δ (n + 3)) (δ (n + 4)) (δ (n + 5)) (δ (n + 6)) (δ (n + 7)) (δ (n + 8)) (δ (n + 9)) (δ (n + 10)) (δ (n + 11)) (δ (n + 12)) (δ (n + 13)) (δ (n + 14)) (δ (n + 15))
    (Int.fract_nonneg _) (Int.fract_lt_one _)
    (by have := delta_add n 1 1 (by norm_num; linarith) (by norm_num; linarith); push_cast at this; exact this)
    ⟨Int.fract_nonneg _, Int.fract_lt_one _⟩
    (by have := delta_add n 2 3 (by norm_num; linarith) (by norm_num; linarith); push_cast at this; exact this)
