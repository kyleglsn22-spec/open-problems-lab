/-- Real-arithmetic core of the up window with members at offsets `[0, 3, 5, 7]`. -/
theorem core_w0_3_5_7 (x d1 d2 d3 d4 d5 d6 d7 : ℝ)
    (hx0 : 0 ≤ x) (hx1 : x < 1)
    (e1 : d1 = x + (1 * φ - 1) ∨ d1 = x + (1 * φ - 1) - 1) (b1 : 0 ≤ d1 ∧ d1 < 1)
    (e2 : d2 = x + (2 * φ - 3) ∨ d2 = x + (2 * φ - 3) - 1) (b2 : 0 ≤ d2 ∧ d2 < 1)
    (e3 : d3 = x + (3 * φ - 4) ∨ d3 = x + (3 * φ - 4) - 1) (b3 : 0 ≤ d3 ∧ d3 < 1)
    (e4 : d4 = x + (4 * φ - 6) ∨ d4 = x + (4 * φ - 6) - 1) (b4 : 0 ≤ d4 ∧ d4 < 1)
    (e5 : d5 = x + (5 * φ - 8) ∨ d5 = x + (5 * φ - 8) - 1) (b5 : 0 ≤ d5 ∧ d5 < 1)
    (e6 : d6 = x + (6 * φ - 9) ∨ d6 = x + (6 * φ - 9) - 1) (b6 : 0 ≤ d6 ∧ d6 < 1)
    (e7 : d7 = x + (7 * φ - 11) ∨ d7 = x + (7 * φ - 11) - 1) (b7 : 0 ≤ d7 ∧ d7 < 1)
    (t0 : η < x)
    (t1 : d1 < ρ)
    (t2 : d2 < ρ)
    (t3 : η < d3)
    (t4 : d4 < ρ)
    (t5 : η < d5)
    (t6 : d6 < ρ)
    (t7 : η < d7)
    (s0_2 : 1 - θ₃ < x)
    (s3_2 : 1 - θ₂ < d3)
    (s5_4 : 1 - θ₂ < d5)
    (s5_2 : 1 - θ₄ < d5)
    (s7_6 : 1 - θ₂ < d7)
    (s7_4 : 1 - θ₄ < d7) : False := by
  have hp := phi_bounds
  simp only [ρ, η, θ₂, θ₃, θ₄, θ₅, θ₆] at *
  obtain ⟨hp1, hp2⟩ := hp
  obtain ⟨b1l, b1r⟩ := b1
  obtain ⟨b2l, b2r⟩ := b2
  obtain ⟨b3l, b3r⟩ := b3
  obtain ⟨b4l, b4r⟩ := b4
  obtain ⟨b5l, b5r⟩ := b5
  obtain ⟨b6l, b6r⟩ := b6
  obtain ⟨b7l, b7r⟩ := b7
  rcases e1 with e1 | e1 <;> subst e1 <;> (try linarith) <;>
    rcases e2 with e2 | e2 <;> subst e2 <;> (try linarith) <;>
    rcases e3 with e3 | e3 <;> subst e3 <;> (try linarith) <;>
    rcases e4 with e4 | e4 <;> subst e4 <;> (try linarith) <;>
    rcases e5 with e5 | e5 <;> subst e5 <;> (try linarith) <;>
    rcases e6 with e6 | e6 <;> subst e6 <;> (try linarith) <;>
    rcases e7 with e7 | e7 <;> subst e7 <;> (try linarith)

/-- No `r + 1 = 4` consecutive up-integers `≥ 105` sit at offsets `[0, 3, 5, 7]`. -/
theorem w0_3_5_7 {k0 k1 k2 k3 : ℕ}
    (hk1 : k1 = k0 + 1)
    (hk2 : k2 = k1 + 1)
    (hk3 : k3 = k2 + 1)
