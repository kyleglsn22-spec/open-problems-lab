    M3.lt_delta
    (isDown_of_not_isUp (by omega) N4).delta_lt
    M5.lt_delta
    (isDown_of_not_isUp (by omega) N6).delta_lt
    M7.lt_delta
    (lt_of_not_ge fun hθ => N2 (by have hh := up_plus2 (N := n) (by omega) M0 hθ; rwa [show n + 2 = n + 2 by omega] at hh))
    (lt_of_not_ge fun hθ => N2 (by have hh := up_minus1 (N := n + 3) (by omega) M3 hθ; rwa [show n + 3 - 1 = n + 2 by omega] at hh))
    (lt_of_not_ge fun hθ => N4 (by have hh := up_minus1 (N := n + 5) (by omega) M5 hθ; rwa [show n + 5 - 1 = n + 4 by omega] at hh))
    (lt_of_not_ge fun hθ => N2 (by have hh := up_minus3 (N := n + 5) (by omega) M5 hθ; rwa [show n + 5 - 3 = n + 2 by omega] at hh))
    (lt_of_not_ge fun hθ => N6 (by have hh := up_minus1 (N := n + 7) (by omega) M7 hθ; rwa [show n + 7 - 1 = n + 6 by omega] at hh))
    (lt_of_not_ge fun hθ => N4 (by have hh := up_minus3 (N := n + 7) (by omega) M7 hθ; rwa [show n + 7 - 3 = n + 4 by omega] at hh))

