  have N2 : ¬ IsUp (n + 2) := not_mem_between' hinf (k := k0) (k' := k1) hk1 (by omega) (by omega)
  have N4 : ¬ IsUp (n + 4) := not_mem_between' hinf (k := k1) (k' := k2) hk2 (by omega) (by omega)
  have N6 : ¬ IsUp (n + 6) := not_mem_between' hinf (k := k2) (k' := k3) hk3 (by omega) (by omega)
  exact core_w0_3_5_7
    (δ n) (δ (n + 1)) (δ (n + 2)) (δ (n + 3)) (δ (n + 4)) (δ (n + 5)) (δ (n + 6)) (δ (n + 7))
    (Int.fract_nonneg _) (Int.fract_lt_one _)
