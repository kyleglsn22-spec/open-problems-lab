  have M22 : IsDown (n + 22) := e8 ▸ Nat.nth_mem_of_infinite hinf k8
  have N1 : ¬ IsDown (n + 1) := not_mem_between' hinf (k := k0) (k' := k1) hk1 (by omega) (by omega)
