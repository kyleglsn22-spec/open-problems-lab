    (e2 : nth IsDown k2 = n + 6)
    (e3 : nth IsDown k3 = n + 8)
    (e4 : nth IsDown k4 = n + 11)
    (e5 : nth IsDown k5 = n + 14)
    (e6 : nth IsDown k6 = n + 16)
    (e7 : nth IsDown k7 = n + 19)
    (e8 : nth IsDown k8 = n + 22) : False := by
