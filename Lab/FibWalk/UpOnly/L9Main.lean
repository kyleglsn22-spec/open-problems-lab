/-!
# `25 ∈ U_9 \ D_9`: the 9-step gap sets differ

Generated by `explorer/fib-walk/gen_up_only.py 9 25 30`.
* `25 ∈ U_9`: the up-integers `30, 32, 35, 37, 40, 42, 45, 50, 53, 55` are consecutive (`30 + 25 = 55`).
* `25 ∉ D_9`: for `d_k < 105` this is a table check. For `d_k ≥ 105` the 9 gaps `s_i` lie in
  `[1, 5]`, and a generated case tree rules out every sequence with sum `25`. Each branch is cut either
  by arithmetic or by a window lemma from `UpOnly/L9Patterns*.lean`.
-/

namespace OpenProblemsLab.FibWalk

open Nat (count nth)
open scoped Classical

lemma ut_wit_uo9 : (ut 30 && ut (30 + 25) && (count (fun i => ut (30 + 1 + i) = true) 24 == 8)) = true := by
  decide +kernel

/-- **`25 ∈ U_9`**. -/
theorem up_only_mem_up9 : 25 ∈ gapSet IsUp 9 := by
  have h := ut_wit_uo9
  simp only [Bool.and_eq_true, beq_iff_eq] at h
  obtain ⟨⟨h0, h1⟩, h2⟩ := h
  have hN := (isUp_iff_ut (by norm_num)).2 h0
  have hM := (isUp_iff_ut (by norm_num)).2 h1
  have hw : count (fun i => IsUp (30 + 1 + i)) (25 - 1) = 9 - 1 := by
    rw [count_congr_lt (q := fun i => ut (30 + 1 + i) = true)
      (fun i hi => isUp_iff_ut (by omega))]
    exact h2
  refine ⟨count IsUp 30, ?_⟩
  rw [nth_add_of_window (by norm_num) (by norm_num) hN hM hw, Nat.nth_count hN]

lemma dt_small_uo9 : ∀ N < 105, dt N = true →
    ¬ (dt (N + 25) = true ∧ count (fun i => dt (N + 1 + i) = true) 24 = 8) := by
  decide +kernel

