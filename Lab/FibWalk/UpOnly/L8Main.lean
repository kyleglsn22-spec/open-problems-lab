/-!
# `17 ∈ U_8 \ D_8`: the 8-step gap sets differ

Generated by `explorer/fib-walk/gen_up_only.py 8 17 25`.
* `17 ∈ U_8`: the up-integers `25, 27, 29, 30, 32, 35, 37, 40, 42` are consecutive (`25 + 17 = 42`).
* `17 ∉ D_8`: for `d_k < 105` this is a table check. For `d_k ≥ 105` the 8 gaps `s_i` lie in
  `[1, 5]`, and a generated case tree rules out every sequence with sum `17`. Each branch is cut either
  by arithmetic or by a window lemma from `UpOnly/L8Patterns*.lean`.
-/

namespace OpenProblemsLab.FibWalk

open Nat (count nth)
open scoped Classical

lemma ut_wit_uo8 : (ut 25 && ut (25 + 17) && (count (fun i => ut (25 + 1 + i) = true) 16 == 7)) = true := by
  decide +kernel

/-- **`17 ∈ U_8`**. -/
theorem up_only_mem_up8 : 17 ∈ gapSet IsUp 8 := by
  have h := ut_wit_uo8
  simp only [Bool.and_eq_true, beq_iff_eq] at h
  obtain ⟨⟨h0, h1⟩, h2⟩ := h
  have hN := (isUp_iff_ut (by norm_num)).2 h0
  have hM := (isUp_iff_ut (by norm_num)).2 h1
  have hw : count (fun i => IsUp (25 + 1 + i)) (17 - 1) = 8 - 1 := by
    rw [count_congr_lt (q := fun i => ut (25 + 1 + i) = true)
      (fun i hi => isUp_iff_ut (by omega))]
    exact h2
  refine ⟨count IsUp 25, ?_⟩
  rw [nth_add_of_window (by norm_num) (by norm_num) hN hM hw, Nat.nth_count hN]

lemma dt_small_uo8 : ∀ N < 105, dt N = true →
    ¬ (dt (N + 17) = true ∧ count (fun i => dt (N + 1 + i) = true) 16 = 7) := by
  decide +kernel

