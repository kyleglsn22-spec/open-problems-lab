/-- No `r + 1 = 5` consecutive down-integers `≥ 105` sit at offsets `[0, 5, 10, 13, 15]`. -/
theorem uo9w0_5_10_13_15 {k0 k1 k2 k3 k4 : ℕ}
    (hk1 : k1 = k0 + 1)
    (hk2 : k2 = k1 + 1)
    (hk3 : k3 = k2 + 1)
    (hk4 : k4 = k3 + 1)
    (n : ℕ) (hn : 105 ≤ n)
    (e0 : nth IsDown k0 = n)
    (e1 : nth IsDown k1 = n + 5)
    (e2 : nth IsDown k2 = n + 10)
    (e3 : nth IsDown k3 = n + 13)
    (e4 : nth IsDown k4 = n + 15) : False := by
