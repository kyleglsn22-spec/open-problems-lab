  have hp := phi_bounds
  have M0 : IsDown n := e0 ▸ Nat.nth_mem_of_infinite hinf k0
  have M5 : IsDown (n + 5) := e1 ▸ Nat.nth_mem_of_infinite hinf k1
  have M10 : IsDown (n + 10) := e2 ▸ Nat.nth_mem_of_infinite hinf k2
  have M13 : IsDown (n + 13) := e3 ▸ Nat.nth_mem_of_infinite hinf k3
  have M15 : IsDown (n + 15) := e4 ▸ Nat.nth_mem_of_infinite hinf k4
