import Lab.FibWalk.Basic

/-!
# The finite case analysis behind `9 ∉ D₄`

Generated by `explorer/fib-walk/gen_core.py`. Inside a window `[n, n+9]` write `x = δ n` and
`d_j = δ (n+j) = {x + jφ}`, and let `D_j` say that `n + j` is a down-integer. Down-integers have
`δ < ρ`, up-integers have `δ > η`, and the shift lemmas of `Basic.lean` say that a down-integer
`n + p` with `δ ≥ θ` forces `n + p + s` to be a down-integer. `core` shows that these constraints
leave no room for `n` and `n + 9` to be down-integers with exactly three down-integers strictly
between them. The proof splits `x` into the ten intervals on which every `d_j` is an explicit
linear function of `x`, then runs through the `2^8` patterns; `linarith` closes every case.
-/

namespace OpenProblemsLab.FibWalk

open Real
open scoped goldenRatio Classical

set_option maxHeartbeats 4000000 in
/-- The case analysis: no window `[n, n+9]` with `n`, `n + 9` down and exactly three
down-integers strictly between them is compatible with the constraints. -/
theorem core (x d1 d2 d3 d4 d5 d6 d7 d8 d9 : ℝ)
    (D1 D2 D3 D4 D5 D6 D7 D8 : Prop)
    (hx0 : 0 ≤ x) (hx : x < ρ) (hd9 : d9 < ρ)
    (e1 : d1 = x + (1 * φ - 1) ∨ d1 = x + (1 * φ - 1) - 1)
    (b1 : 0 ≤ d1 ∧ d1 < 1)
    (e2 : d2 = x + (2 * φ - 3) ∨ d2 = x + (2 * φ - 3) - 1)
    (b2 : 0 ≤ d2 ∧ d2 < 1)
    (e3 : d3 = x + (3 * φ - 4) ∨ d3 = x + (3 * φ - 4) - 1)
    (b3 : 0 ≤ d3 ∧ d3 < 1)
    (e4 : d4 = x + (4 * φ - 6) ∨ d4 = x + (4 * φ - 6) - 1)
    (b4 : 0 ≤ d4 ∧ d4 < 1)
    (e5 : d5 = x + (5 * φ - 8) ∨ d5 = x + (5 * φ - 8) - 1)
    (b5 : 0 ≤ d5 ∧ d5 < 1)
    (e6 : d6 = x + (6 * φ - 9) ∨ d6 = x + (6 * φ - 9) - 1)
    (b6 : 0 ≤ d6 ∧ d6 < 1)
    (e7 : d7 = x + (7 * φ - 11) ∨ d7 = x + (7 * φ - 11) - 1)
    (b7 : 0 ≤ d7 ∧ d7 < 1)
    (e8 : d8 = x + (8 * φ - 12) ∨ d8 = x + (8 * φ - 12) - 1)
    (b8 : 0 ≤ d8 ∧ d8 < 1)
    (e9 : d9 = x + (9 * φ - 14) ∨ d9 = x + (9 * φ - 14) - 1)
    (b9 : 0 ≤ d9 ∧ d9 < 1)
    (hD1 : D1 → d1 < ρ) (hU1 : ¬ D1 → η < d1)
    (hD2 : D2 → d2 < ρ) (hU2 : ¬ D2 → η < d2)
    (hD3 : D3 → d3 < ρ) (hU3 : ¬ D3 → η < d3)
    (hD4 : D4 → d4 < ρ) (hU4 : ¬ D4 → η < d4)
    (hD5 : D5 → d5 < ρ) (hU5 : ¬ D5 → η < d5)
    (hD6 : D6 → d6 < ρ) (hU6 : ¬ D6 → η < d6)
    (hD7 : D7 → d7 < ρ) (hU7 : ¬ D7 → η < d7)
    (hD8 : D8 → d8 < ρ) (hU8 : ¬ D8 → η < d8)
    (hS0_1 : ¬ D1 → x < θ₂)
    (hS0_3 : ¬ D3 → x < θ₄)
    (hS0_8 : ¬ D8 → x < θ₆)
    (hS1_2 : D1 → ¬ D2 → d1 < θ₂)
    (hS1_4 : D1 → ¬ D4 → d1 < θ₄)
    (hS2_3 : D2 → ¬ D3 → d2 < θ₂)
    (hS2_5 : D2 → ¬ D5 → d2 < θ₄)
    (hS3_4 : D3 → ¬ D4 → d3 < θ₂)
    (hS3_1 : D3 → ¬ D1 → d3 < θ₃)
    (hS3_6 : D3 → ¬ D6 → d3 < θ₄)
    (hS4_5 : D4 → ¬ D5 → d4 < θ₂)
    (hS4_2 : D4 → ¬ D2 → d4 < θ₃)
    (hS4_7 : D4 → ¬ D7 → d4 < θ₄)
    (hS5_6 : D5 → ¬ D6 → d5 < θ₂)
    (hS5_3 : D5 → ¬ D3 → d5 < θ₃)
    (hS5_8 : D5 → ¬ D8 → d5 < θ₄)
    (hS6_7 : D6 → ¬ D7 → d6 < θ₂)
    (hS6_4 : D6 → ¬ D4 → d6 < θ₃)
    (hS6_1 : D6 → ¬ D1 → d6 < θ₅)
    (hS7_8 : D7 → ¬ D8 → d7 < θ₂)
    (hS7_5 : D7 → ¬ D5 → d7 < θ₃)
    (hS7_2 : D7 → ¬ D2 → d7 < θ₅)
    (hS8_6 : D8 → ¬ D6 → d8 < θ₃)
    (hS8_3 : D8 → ¬ D3 → d8 < θ₅)
    (hS9_7 : ¬ D7 → d9 < θ₃)
    (hS9_4 : ¬ D4 → d9 < θ₅)
    (hc : (if D1 then 1 else 0) + (if D2 then 1 else 0) + (if D3 then 1 else 0) + (if D4 then 1 else 0) + (if D5 then 1 else 0) + (if D6 then 1 else 0) + (if D7 then 1 else 0) + (if D8 then 1 else 0) = 3) : False := by
  have hp := phi_bounds
  simp only [ρ, η, θ₂, θ₃, θ₄, θ₅, θ₆] at *
  obtain ⟨hp1, hp2⟩ := hp
  obtain ⟨b1l, b1r⟩ := b1
  obtain ⟨b2l, b2r⟩ := b2
  obtain ⟨b3l, b3r⟩ := b3
  obtain ⟨b4l, b4r⟩ := b4
  obtain ⟨b5l, b5r⟩ := b5
  obtain ⟨b6l, b6r⟩ := b6
  obtain ⟨b7l, b7r⟩ := b7
  obtain ⟨b8l, b8r⟩ := b8
  obtain ⟨b9l, b9r⟩ := b9
  rcases e1 with e1 | e1 <;> subst e1 <;> (try linarith) <;>
  rcases e2 with e2 | e2 <;> subst e2 <;> (try linarith) <;>
  rcases e3 with e3 | e3 <;> subst e3 <;> (try linarith) <;>
  rcases e4 with e4 | e4 <;> subst e4 <;> (try linarith) <;>
  rcases e5 with e5 | e5 <;> subst e5 <;> (try linarith) <;>
  rcases e6 with e6 | e6 <;> subst e6 <;> (try linarith) <;>
  rcases e7 with e7 | e7 <;> subst e7 <;> (try linarith) <;>
  rcases e8 with e8 | e8 <;> subst e8 <;> (try linarith) <;>
  rcases e9 with e9 | e9 <;> subst e9 <;> (try linarith) <;>
  (by_cases h1 : D1 <;>
    by_cases h2 : D2 <;>
    by_cases h3 : D3 <;>
    by_cases h4 : D4 <;>
    by_cases h5 : D5 <;>
    by_cases h6 : D6 <;>
    by_cases h7 : D7 <;>
    by_cases h8 : D8 <;>
    simp only [h1, h2, h3, h4, h5, h6, h7, h8, if_true, if_false] at hc <;> norm_num at hc <;>
    simp only [h1, h2, h3, h4, h5, h6, h7, h8, not_true_eq_false, not_false_eq_true,
      IsEmpty.forall_iff, forall_const] at * <;>
    linarith)

end OpenProblemsLab.FibWalk
